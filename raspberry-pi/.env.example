# Copy to .env on the Raspberry Pi. Never commit the populated file.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=
DATABASE_SSL_SERVERNAME=

API_HOST=127.0.0.1
API_PORT=3002

PG_POOL_MAX=4
PG_CONNECTION_TIMEOUT_MS=2000
PG_QUERY_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000

ENABLE_LIVE_TRADING=false
