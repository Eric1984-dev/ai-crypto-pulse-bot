# Copy to .env on the Raspberry Pi. Never commit the populated file.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=
DATABASE_SSL_SERVERNAME=

# Separate login used only by market-data ingestion; never use it for the API.
# When table-owner mode is enabled, this login must differ from DATABASE_USER.
INGESTION_DATABASE_USER=
INGESTION_DATABASE_PASSWORD=
# Defaults to false; true explicitly accepts ownership only for this ingestion login.
INGESTION_ALLOW_TABLE_OWNER=false

# Separate, non-owner role used only by AI analysis.
# It requires SELECT on the AI read-contract tables and INSERT only on AI decisions.
AI_DATABASE_USER=
AI_DATABASE_PASSWORD=

# Separate, non-owner role used only by paper trading and runtime status updates.
# It must differ from DATABASE_USER, INGESTION_DATABASE_USER, and AI_DATABASE_USER.
PAPER_DATABASE_USER=
PAPER_DATABASE_PASSWORD=

# Separate, non-owner role used only by the manual analytics-history generator.
# It requires INSERT only on AI_Crypto_Bot_Analytics_Runs and must differ from
# DATABASE_USER, INGESTION_DATABASE_USER, AI_DATABASE_USER, and PAPER_DATABASE_USER.
ANALYTICS_DATABASE_USER=
ANALYTICS_DATABASE_PASSWORD=

API_HOST=127.0.0.1
API_PORT=3002
# One dashboard administrator; configure a bcrypt hash, never a plaintext password.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
# Set exact browser origins for the dashboard deployment; leave empty if unused.
API_CORS_ORIGINS=
# Optional. Keep false for private-network or local development access.
# Set true to require Cloudflare Access JWT validation on dashboard data routes.
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_AUDIENCE=
ALLOWED_OPERATOR_EMAILS=
API_SESSION_TTL_MS=28800000
API_SESSION_MAX=1000
# Persistent session data must live outside the application checkout.
# The systemd unit manages this path through StateDirectory=cryptopulse.
API_SESSION_STORE_PATH=/var/lib/cryptopulse/dashboard-sessions.json
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=60

PG_POOL_MAX=4
PG_CONNECTION_TIMEOUT_MS=2000
PG_QUERY_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000

ENABLE_LIVE_TRADING=false
