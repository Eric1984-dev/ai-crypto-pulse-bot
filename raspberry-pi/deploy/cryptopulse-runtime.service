[Unit]
Description=CryptoPulse Raspberry Pi Runtime
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=eric
Group=eric
WorkingDirectory=/home/eric/ai-crypto-pulse-bot/raspberry-pi
EnvironmentFile=/home/eric/ai-crypto-pulse-bot/raspberry-pi/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.mjs
Restart=always
RestartSec=10s
TimeoutStopSec=125s
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
